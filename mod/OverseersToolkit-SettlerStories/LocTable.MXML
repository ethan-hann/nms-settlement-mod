		<Property name="Table" value="TkLocalisationEntry">
			<Property name="Id" value="OT_SS_ORCHARD_DS" />
			<Property name="English" value="A crop nobody alive had ever grown, now thriving in the settlement's fields." />
			<Property name="French" value="Une culture que personne de vivant n'avait jamais cultivée prospère désormais dans les champs de la colonie." />
			<Property name="Italian" value="Una coltura che nessun vivente aveva mai coltivato, ora rigogliosa nei campi dell'insediamento." />
			<Property name="German" value="Eine Pflanze, die zu Lebzeiten niemand angebaut hat, gedeiht nun auf den Feldern der Siedlung." />
			<Property name="Spanish" value="Un cultivo que nadie vivo había cultivado jamás, ahora floreciente en los campos del asentamiento." />
			<Property name="Russian" value="Культура, которую никто из ныне живущих не выращивал, теперь буйно растет на полях поселения." />
			<Property name="Polish" value="Roślina, której nikt z żyjących nigdy nie uprawiał, teraz bujnie rośnie na polach osady." />
			<Property name="Dutch" value="Een gewas dat niemand die nu leeft ooit heeft geteeld, groeit nu goed op de velden van de nederzetting." />
			<Property name="Portuguese" value="Uma cultura que ninguém vivo alguma vez cultivou, agora a prosperar nos campos do povoamento." />
			<Property name="LatinAmericanSpanish" value="Un cultivo que nadie vivo había cultivado antes, ahora próspero en los campos del asentamiento." />
			<Property name="BrazilianPortuguese" value="Uma colheita que ninguém vivo jamais cultivou, agora prosperando nos campos do povoado." />
			<Property name="SimplifiedChinese" value="一种在世者无人种过的作物，如今在定居点的田地里茁壮生长。" />
			<Property name="TraditionalChinese" value="一種在世者無人種過的作物，如今在聚居地的田地裡茁壯生長。" />
			<Property name="TencentChinese" value="一种在世者无人种过的作物，如今在定居点的田地里茁壮生长。" />
			<Property name="Korean" value="살아 있는 누구도 길러 본 적 없는 작물이 거주지 밭에서 무럭무럭 자라고 있습니다." />
			<Property name="Japanese" value="生きている者の誰も育てたことのない作物が、開拓地の畑で元気に育っている。" />
			<Property name="USEnglish" value="A crop nobody alive had ever grown, now thriving in the settlement's fields." />
		</Property>
