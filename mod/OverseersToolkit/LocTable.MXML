		<Property name="Table" value="TkLocalisationEntry">
			<Property name="Id" value="OT_PATH_TILE_DESC" />
			<Property name="English" value="A small stone tile for laying paths, plazas and walkways." />
			<Property name="French" value="Une petite dalle de pierre pour tracer des chemins, des places et des allées." />
			<Property name="Italian" value="Una piccola piastrella di pietra per realizzare sentieri, piazze e passerelle." />
			<Property name="German" value="Eine kleine Steinplatte für Wege, Plätze und Gehwege." />
			<Property name="Spanish" value="Una pequeña losa de piedra para trazar caminos, plazas y pasarelas." />
			<Property name="Russian" value="Небольшая каменная плитка для мощения дорожек, площадей и пешеходных путей." />
			<Property name="Polish" value="Mała kamienna płytka do układania ścieżek, placów i chodników." />
			<Property name="Dutch" value="Een kleine stenen tegel voor paden, pleinen en wandelwegen." />
			<Property name="Portuguese" value="Uma pequena lajeta de pedra para fazer caminhos, praças e passeios." />
			<Property name="LatinAmericanSpanish" value="Una pequeña loseta de piedra para trazar caminos, plazas y pasarelas." />
			<Property name="BrazilianPortuguese" value="Um pequeno ladrilho de pedra para fazer caminhos, praças e calçadas." />
			<Property name="SimplifiedChinese" value="小块石砖，用于铺设小径、广场和步道。" />
			<Property name="TraditionalChinese" value="小塊石磚，用於鋪設小徑、廣場和步道。" />
			<Property name="TencentChinese" value="小块石砖，用于铺设小径、广场和步道。" />
			<Property name="Korean" value="길, 광장, 보도를 까는 데 쓰는 작은 석제 타일입니다." />
			<Property name="Japanese" value="小道や広場、遊歩道に敷く小さな石のタイル。" />
			<Property name="USEnglish" value="A small stone tile for laying paths, plazas and walkways." />
		</Property>
