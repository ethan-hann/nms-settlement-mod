		<Property name="Table" value="TkLocalisationEntry">
			<Property name="Id" value="OT_PATH_TRI_DESC" />
			<Property name="English" value="A small triangular stone tile for turning corners and filling gaps along a path." />
			<Property name="French" value="Une petite dalle triangulaire de pierre pour tourner aux angles et combler les vides le long d'un chemin." />
			<Property name="Italian" value="Una piccola piastrella triangolare di pietra per girare gli angoli e riempire gli spazi lungo un sentiero." />
			<Property name="German" value="Eine kleine dreieckige Steinplatte für Wegbiegungen und zum Füllen von Lücken entlang eines Wegs." />
			<Property name="Spanish" value="Una pequeña losa triangular de piedra para girar en las esquinas y rellenar huecos a lo largo de un camino." />
			<Property name="Russian" value="Небольшая треугольная каменная плитка, чтобы поворачивать дорожку на углах и заполнять пробелы." />
			<Property name="Polish" value="Mała trójkątna kamienna płytka do zakrętów i wypełniania luk wzdłuż ścieżki." />
			<Property name="Dutch" value="Een kleine driehoekige stenen tegel voor bochten en om gaten langs een pad op te vullen." />
			<Property name="Portuguese" value="Uma pequena lajeta de pedra triangular para fazer curvas e preencher falhas ao longo de um caminho." />
			<Property name="LatinAmericanSpanish" value="Una pequeña loseta triangular de piedra para doblar en las esquinas y rellenar huecos a lo largo de un camino." />
			<Property name="BrazilianPortuguese" value="Um pequeno ladrilho de pedra triangular para fazer curvas e preencher vãos ao longo de um caminho." />
			<Property name="SimplifiedChinese" value="小块三角形石砖，用于小径转角和填补空隙。" />
			<Property name="TraditionalChinese" value="小塊三角形石磚，用於小徑轉角和填補空隙。" />
			<Property name="TencentChinese" value="小块三角形石砖，用于小径转角和填补空隙。" />
			<Property name="Korean" value="길의 모서리를 돌리거나 틈을 메우는 데 쓰는 작은 삼각형 석제 타일입니다." />
			<Property name="Japanese" value="小道の角を曲がったり隙間を埋めたりするための、小さな三角形の石タイル。" />
			<Property name="USEnglish" value="A small triangular stone tile for turning corners and filling gaps along a path." />
		</Property>
