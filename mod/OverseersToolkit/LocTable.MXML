		<Property name="Table" value="TkLocalisationEntry">
			<Property name="Id" value="OT_LAMP_DESC" />
			<Property name="English" value="A standing street lamp for lighting paths and plazas. It needs no power." />
			<Property name="French" value="Un lampadaire sur pied pour éclairer chemins et places. Il n'a besoin d'aucune alimentation." />
			<Property name="Italian" value="Un lampione a stelo per illuminare sentieri e piazze. Non richiede alimentazione." />
			<Property name="German" value="Eine freistehende Straßenlaterne zur Beleuchtung von Wegen und Plätzen. Sie braucht keinen Strom." />
			<Property name="Spanish" value="Una farola de pie para iluminar caminos y plazas. No necesita energía." />
			<Property name="Russian" value="Стоячий уличный фонарь для освещения дорожек и площадей. Питание не требуется." />
			<Property name="Polish" value="Wolno stojąca latarnia uliczna do oświetlania ścieżek i placów. Nie potrzebuje zasilania." />
			<Property name="Dutch" value="Een vrijstaande straatlantaarn om paden en pleinen te verlichten. Er is geen stroom voor nodig." />
			<Property name="Portuguese" value="Um candeeiro de rua independente para iluminar caminhos e praças. Não precisa de energia." />
			<Property name="LatinAmericanSpanish" value="Un farol de pie para iluminar caminos y plazas. No necesita energía." />
			<Property name="BrazilianPortuguese" value="Um poste de iluminação independente para iluminar caminhos e praças. Não precisa de energia." />
			<Property name="SimplifiedChinese" value="立式路灯，用于照亮小径和广场，无需供电。" />
			<Property name="TraditionalChinese" value="立式路燈，用於照亮小徑和廣場，不需供電。" />
