		<Property name="Table" value="TkLocalisationEntry">
			<Property name="Id" value="UI_SETTLEMENT_PROD_DEBT" />
			<Property name="English" value="In debt: production is paused until the debt is paid" />
			<Property name="French" value="Endettée : la production est suspendue jusqu'au remboursement de la dette" />
			<Property name="Italian" value="Indebitato: la produzione è sospesa finché il debito non è saldato" />
			<Property name="German" value="Verschuldet: Die Produktion ruht, bis die Schulden getilgt sind" />
			<Property name="Spanish" value="Endeudado: la producción está en pausa hasta saldar la deuda" />
			<Property name="Russian" value="Есть долг: производство остановлено до его погашения" />
			<Property name="Polish" value="Zadłużenie: produkcja wstrzymana do spłaty długu" />
			<Property name="Dutch" value="Schulden: de productie ligt stil tot de schuld is afbetaald" />
			<Property name="Portuguese" value="Com dívidas: a produção está parada até a dívida ser saldada" />
			<Property name="LatinAmericanSpanish" value="Con deuda: la producción está en pausa hasta saldar la deuda" />
			<Property name="BrazilianPortuguese" value="Em dívida: a produção fica pausada até a dívida ser paga" />
			<Property name="SimplifiedChinese" value="负债中：还清债务前生产暂停" />
			<Property name="TraditionalChinese" value="負債中：清償債務前暫停生產" />
			<Property name="TencentChinese" value="负债中：还清债务前生产暂停" />
			<Property name="Korean" value="부채 있음: 부채를 상환할 때까지 생산 중단" />
			<Property name="Japanese" value="負債あり：負債を完済するまで生産は停止する" />
			<Property name="USEnglish" value="In debt: production is paused until the debt is paid" />
