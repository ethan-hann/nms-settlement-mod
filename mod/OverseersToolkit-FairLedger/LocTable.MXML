		<Property name="Table" value="TkLocalisationEntry">
			<Property name="Id" value="UI_SETTLEMENT_PROD_DEBT" />
			<Property name="English" value="Settlement is in debt &lt;IMG&gt;SLASH&lt;&gt; Production is paused until the debt is paid" />
			<Property name="French" value="Colonie endettée &lt;IMG&gt;SLASH&lt;&gt; La production est suspendue jusqu'au remboursement de la dette" />
			<Property name="Italian" value="L'insediamento è indebitato &lt;IMG&gt;SLASH&lt;&gt; La produzione è sospesa finché il debito non è saldato" />
			<Property name="German" value="Siedlung hat Schulden &lt;IMG&gt;SLASH&lt;&gt; Die Produktion ruht, bis die Schulden getilgt sind" />
			<Property name="Spanish" value="El asentamiento está endeudado &lt;IMG&gt;SLASH&lt;&gt; La producción está en pausa hasta saldar la deuda" />
			<Property name="Russian" value="У поселения долги &lt;IMG&gt;SLASH&lt;&gt; Производство остановлено до их погашения" />
			<Property name="Polish" value="Osada zadłużona &lt;IMG&gt;SLASH&lt;&gt; Produkcja wstrzymana do spłaty długu" />
			<Property name="Dutch" value="De nederzetting heeft schulden &lt;IMG&gt;SLASH&lt;&gt; De productie ligt stil tot de schuld is afbetaald" />
			<Property name="Portuguese" value="O povoamento tem dívidas &lt;IMG&gt;SLASH&lt;&gt; A produção está parada até a dívida ser saldada" />
			<Property name="LatinAmericanSpanish" value="El asentamiento tiene una deuda &lt;IMG&gt;SLASH&lt;&gt; La producción está en pausa hasta saldar la deuda" />
			<Property name="BrazilianPortuguese" value="O povoado está em dívida &lt;IMG&gt;SLASH&lt;&gt; A produção fica pausada até a dívida ser paga" />
			<Property name="SimplifiedChinese" value="定居点已负债&lt;IMG&gt;SLASH&lt;&gt;还清债务前生产暂停" />
			<Property name="TraditionalChinese" value="聚居地負債中 &lt;IMG&gt;SLASH&lt;&gt; 清償債務前暫停生產" />
			<Property name="TencentChinese" value="定居点已负债&lt;IMG&gt;SLASH&lt;&gt;还清债务前生产暂停" />
			<Property name="Korean" value="거주지에 부채 있음 &lt;IMG&gt;SLASH&lt;&gt; 부채를 상환할 때까지 생산 중단" />
			<Property name="Japanese" value="開拓地が負債を抱えている&lt;IMG&gt;SLASH&lt;&gt;負債を完済するまで生産は停止する" />
			<Property name="USEnglish" value="Settlement is in debt &lt;IMG&gt;SLASH&lt;&gt; Production is paused until the debt is paid" />
